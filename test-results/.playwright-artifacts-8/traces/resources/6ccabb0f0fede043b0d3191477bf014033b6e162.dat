  wp = inject(WpApiService);
  cdr = inject(ChangeDetectorRef);
  data = {};
  schools = [];
  currentProgramIndex = 0;
  campusLifeItems = [];
  news = [];
  selectedNews = null;
  loading = false;
  error = "";
  playerElement;
  constructor() {
    this.wp.getPage("home").subscribe({
      next: (pages) => {
        if (pages.length > 0)
          this.data = pages[0].acf ?? {};
        this.cdr.markForCheck();
      }
    });
    this.wp.getSchools().subscribe((s) => {
      this.schools = s;
      this.cdr.markForCheck();
    });
    this.wp.getCampusLife().subscribe((c) => {
      this.campusLifeItems = c;
      this.cdr.markForCheck();
    });
    this.wp.getNews().subscribe((n) => {
      this.news = n;
      if (n.length > 0) {
        this.selectedNews = n.find((item) => item.acf.featured) || n[0];
      }
      this.cdr.markForCheck();
    });
  }
  selectNews(item) {
    this.selectedNews = item;
    this.cdr.markForCheck();
  }
  get featuredNews() {
    return this.news.find((n) => n.acf.featured);
  }
  get regularNews() {
    return this.news.filter((n) => !n.acf.featured);
  }
  get heroStats() {
    return [
      { value: "10+", label: "YEARS OF EXCELLENCE" },
      { value: this.data["stat_programmes"] || "10+", label: "ACADEMIC PROGRAMS" },
      { value: this.data["stat_students"] || "1000+", label: "ENROLLED STUDENTS" }
    ];
  }
  get heroDescription() {
    return this.data["hero_subtext"] || "For over the years, Lukenya University has shaped visionary leaders, groundbreaking researchers, and compassionate global citizens.";
  }
  get heroImage() {
    return this.data["hero_image"] || "/home/hero.webp";
  }
  get heroPillText() {
    return "\u2022 EST. 1991 \u2022 EXCELLENCE IN EDUCATION";
  }
  get primaryButtonText() {
    return this.data["hero_cta_label"] || "Apply for 2026";
  }
  get primaryButtonLink() {
    return this.data["hero_cta_url"] || "/application-overview";
  }
  get secondaryButtonText() {
    return this.data["hero_cta_secondary_label"] || "Explore Programs";
  }
  get secondaryButtonLink() {
    return this.data["hero_cta_secondary_url"] || "/academics";
  }
  get heroHeadline() {
    return this.data["hero_headline"] || "Shape the Future of Tomorrow.";
  }
  parseHeadline(headline) {
    const parts = headline.split(/(\w+\.?)/g);
    return {
      prefix: parts.slice(0, -2).join(""),
      highlight: parts.slice(-2, -1)[0] || "Future",
      suffix: parts.slice(-1)[0] || ""
    };
  }
  get studyingIntro() {
    return this.data["studying_intro"] || "";
  }
  get campusTitle() {
    return this.data["campus_title"] || "CAMPUS";
  }
  get campusDescription() {
    return this.data["campus_description"] || "";
  }
  get campusImage() {
    return this.data["campus_image"] || "/home/below_hero.webp";
  }
  get campusLinkLabel() {
    return this.data["campus_link_label"] || "University Overview";
  }
  get campusLinkUrl() {
    return this.data["campus_link_url"] || "/about";
  }
  playVideo() {
    this.playerElement?.nativeElement?.play();
  }
  pauseVideo() {
    this.playerElement?.nativeElement?.pause();
  }
  nextProgram() {
    if (this.currentProgramIndex < this.schools.length - 3) {
      this.currentProgramIndex++;
      this.cdr.markForCheck();
    }
  }
  prevProgram() {
    if (this.currentProgramIndex > 0) {
      this.currentProgramIndex--;
      this.cdr.markForCheck();
    }
  }
  get totalDots() {
    return Math.max(0, this.schools.length - 2);
  }
  scrollToTop() {
    window.scrollTo({ top: 0, behavior: "smooth" });
  }
