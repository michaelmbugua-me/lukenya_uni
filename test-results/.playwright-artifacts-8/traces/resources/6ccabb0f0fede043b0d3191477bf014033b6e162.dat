.section-heading[_ngcontent-%COMP%] {\n  display: block;\n}\n.news[_ngcontent-%COMP%]   .section-heading[_ngcontent-%COMP%] {\n  display: block;\n}\n.life-grid[_ngcontent-%COMP%] {\n  display: grid;\n  gap: 18px;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  margin-bottom: 78px;\n}\n.life-grid[_ngcontent-%COMP%]   article[_ngcontent-%COMP%] {\n  border-radius: 20px;\n  max-height: clamp(320px, 31vw, 420px);\n  overflow: hidden;\n  position: relative;\n}\n.life-grid[_ngcontent-%COMP%]   article.wide[_ngcontent-%COMP%] {\n  grid-column: 1 / -1;\n  min-height: clamp(330px, 30vw, 420px);\n}\n.life-grid[_ngcontent-%COMP%]   img[_ngcontent-%COMP%] {\n  height: 100%;\n  object-fit: cover;\n  width: 100%;\n}\n.life-grid[_ngcontent-%COMP%]   article[_ngcontent-%COMP%]::before {\n  background:\n    linear-gradient(\n      180deg,\n      rgba(0, 0, 0, 0.16) 8%,\n      rgba(0, 0, 0, 0.78) 100%);\n  content: "";\n  inset: 0;\n  position: absolute;\n}\n.life-grid[_ngcontent-%COMP%]   div[_ngcontent-%COMP%] {\n  bottom: 26px;\n  color: #ffffff;\n  left: 26px;\n  position: absolute;\n  z-index: 1;\n}\n.life-grid[_ngcontent-%COMP%]   span[_ngcontent-%COMP%] {\n  font-size: 18px;\n}\n.life-grid[_ngcontent-%COMP%]   p[_ngcontent-%COMP%] {\n  color: rgba(255, 255, 255, 0.9);\n  font-size: clamp(15px, 0.95vw, 17px);\n  line-height: 1.42;\n  margin: 8px 0 0;\n  max-width: 470px;\n}\n.life-grid[_ngcontent-%COMP%]   article.wide[_ngcontent-%COMP%]   p[_ngcontent-%COMP%] {\n  border-top: 1px solid rgba(255, 255, 255, 0.65);\n  display: inline-block;\n  margin: 0 0 12px;\n  padding-top: 10px;\n}\n.life-grid[_ngcontent-%COMP%]   h3[_ngcontent-%COMP%] {\n  font-size: clamp(28px, 2vw, 40px);\n  margin: 8px 0 0;\n  max-width: 620px;\n}\n.life-grid[_ngcontent-%COMP%]   article[_ngcontent-%COMP%]:not(.wide)   h3[_ngcontent-%COMP%] {\n  font-size: clamp(24px, 1.45vw, 30px);\n}\n.life-grid[_ngcontent-%COMP%]   strong[_ngcontent-%COMP%] {\n  display: block;\n  font-size: clamp(30px, 1.9vw, 