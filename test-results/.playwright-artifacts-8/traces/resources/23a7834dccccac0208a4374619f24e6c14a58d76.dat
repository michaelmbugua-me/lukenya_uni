  <img [src]="imageUrl" [alt]="imageAlt">
  <div class="hero-overlay"></div>

  @if (showNavigation) {
    <button class="hero-arrow left" (click)="onArrowClick('left')" aria-label="Previous slide">
      <img [src]="leftActive ? '/home/arrow_right.svg' : '/home/arrow_left.svg'" [class.flipped]="leftActive" alt="">
    </button>
    <button class="hero-arrow right" (click)="onArrowClick('right')" aria-label="Next slide">
      <img [src]="rightActive ? '/home/arrow_right.svg' : '/home/arrow_left.svg'" [class.flipped]="!rightActive" alt="">
    </button>
  }

  <div class="hero-content">
    @if (displayPillText) {
      <p class="eyebrow">
        @if (pillIconUrl) {
          <img [src]="pillIconUrl" [alt]="pillIconAlt">
        }
        {{ displayPillText }}
      </p>
    }

    @if (titleHighlight) {
      <h1 [id]="titleId">
        @if (titleBreakBeforeHighlight) {
          {{ titlePrefix }}
          <br>
          <span class="title-highlight">{{ titleHighlight }}</span>
        } @else {
          <span class="title-prefix-highlight">{{ titlePrefix }} <span class="title-highlight">{{ titleHighlight }}</span></span>
        }
        @if (titleBreakAfterHighlight) {
          <br>
        }
        {{ titleSuffix }}
      </h1>
    } @else {
      <h1 [id]="titleId">{{ title }}</h1>
    }

    @if (description) {
      <p [innerHTML]="description"></p>
    }

    @if (showBottomButtons) {
      <div class="hero-actions">
        @if (primaryButtonText) {
          @if (isExternal(primaryButtonLink)) {
            <a class="button yellow" [href]="primaryButtonLink" target="_blank" rel="noopener noreferrer">{{ primaryButtonText }}</a>
          } @else {
            <a class="button yellow" [routerLink]="primaryButtonLink">{{ primaryButtonText }}</a>
          }
        }

        @if (secondaryButtonText) {
          @if (isExternal(secondaryButtonLink)) {
            <a class="button outline" [href]="secondaryButtonLink" target="_blank" rel="noopener noreferrer">{{ secondaryButtonText }}</a>
          } @else {
            <a class="button outline" [routerLink]="secondaryButtonLink">{{ secondaryButtonText }}</a>
          }
        }
      </div>
    } @else {
      @if (buttonText) {
        @if (isExternal(buttonLink)) {
          <a [href]="buttonLink" target="_blank" rel="noopener noreferrer" class="button yellow">{{ buttonText }}</a>
        } @else {
          <a [routerLink]="buttonLink" class="button yellow">{{ buttonText }}</a>
        }
      }
    }

    @if (showStats && stats.length > 0) {
      <div class="hero-stats" aria-label="Highlights">
        @for (stat of stats; track stat.label) {
          <div>
            <strong>{{ stat.value }}</strong>
            <span>{{ stat.label }}</span>
          </div>
        }
      </div>
    }
  </div>

  @if (showScrollControl) {
    <button class="round-control" type="button" [attr.aria-label]="scrollButtonLabel">{{ scrollButtonText }}</button>
  }
</section>
