(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && i0.\u0275setClassMetadata(HeaderComponent, [{
    type: Component,
    args: [{ selector: "app-header", standalone: true, imports: [CommonModule, RouterLink, RouterLinkActive], template: `<div class="topbar">
    <div class="contact-line">
        <span><span>\u260E</span><span>0722 370 485</span></span>
        <span><span>\u2709</span><span>info&#64;lukenyauniversity.ac.ke</span></span>
    </div>
    <nav aria-label="Utility navigation" class="utility-nav"><a href="https://library.lukenyauniversity.ac.ke/" target="_blank" rel="noopener noreferrer">Library</a><a href="https://lu.mzizi.co.ke/ISIMSLogin.aspx" target="_blank" rel="noopener noreferrer">Students</a><a href="#">Staff &amp; Faculty</a><a href="#">Quick Links</a></nav>
</div>
<div class="main-nav">
    <div class="nav-container">
        <a aria-label="Lukenya University home" class="brand" routerLink="/">
            <span>LUKENYA</span>
            <img alt="Lukenya Logo" src="/home/lukenya_logo.svg">
            <span>UNIVERSITY</span>
        </a>

        <!-- Desktop Navigation -->
        <nav aria-label="Primary navigation" class="primary-nav desktop-only">
            <a [routerLinkActiveOptions]="{exact: true}" class="nav-link" routerLink="/" routerLinkActive="active">Home</a>
                <a class="nav-link nav-link-with-icon" routerLink="/about" routerLinkActive="active">
                    About
                </a>
            <div class="nav-item has-dropdown academics-dropdown">
                <a class="nav-link nav-link-with-icon" routerLink="/academics" routerLinkActive="active">
                    <span>Academics</span>
                    <span aria-hidden="true" class="chevron"></span>
                </a>
                <div aria-label="Academics submenu" class="dropdown-menu">
                    <a class="dropdown-link" routerLink="/academics/schools/agriculture-natural-sciences" routerLinkActive="active">School of Agriculture, Technical Studies and Natural Sciences</a>
                    <a class="dropdown-link" routerLink="/academics/schools/health-sciences" routerLinkActive="active">School of Health Sciences</a>
                    <a class="dropdown-link" routerLink="/academics/schools/business-economics" routerLinkActive="active">School of Business and Economics</a>
                    <a class="dropdown-link" routerLink="/academics/schools/education-social-sciences" routerLinkActive="active">School of Education &amp; Social Sciences</a>
                    <a class="dropdown-link" routerLink="/academics/short-courses">Short Courses</a>
                    <a class="dropdown-link" href="https://portal.hef.co.ke/auth/signin" target="_blank" rel="noopener noreferrer">HELB Loan Applications</a>
                </div>
            </div>

            <div class="nav-item has-dropdown academics-dropdown">
                <a class="nav-link nav-link-with-icon" routerLink="/campus-life-overview" routerLinkActive="active">
                    <span>Student</span>
                    <span aria-hidden="true" class="chevron"></span>
                </a>
                <div aria-label="Student submenu" class="dropdown-menu">
                    <a class="dropdown-link" routerLink="/campus-life-overview" routerLinkActive="active">Students Overview</a>
                    <a class="dropdown-link" routerLink="/campus-life-main" routerLinkActive="active">Campus Life</a>
                    <a class="dropdown-link" routerLink="/virtual-tour">Virtual campus</a>
                    <a class="dropdown-link" routerLink="/campus-culture-week" routerLinkActive="active">Lukenya Cultural Week Festival</a>
                    <a class="dropdown-link" href="https://lu.mzizi.co.ke/ISIMSLogin.aspx">Student Portal</a>
                    <a class="dropdown-link" href="#">Download Student Handbook</a>
                    <a class="dropdown-link" href="https://students.kuccps.net/login/" target="_blank" rel="noopener noreferrer">KUCCPS</a>
                </div>
            </div>

            <a class="nav-link" routerLink="/graduation">Graduations</a>
            <a class="nav-link" href="#">Research</a>
            <a class="nav-link" routerLink="/contact" routerLinkActive="active">Contact</a>
        </nav>

        <div class="nav-actions">
            <a class="nav-cta desktop-only" routerLink="/application-overview">Apply Now</a>

            <!-- Hamburger Button -->
            <button type="button" (click)="toggleMenu()" class="mobile-toggle" aria-label="Toggle menu">
                <svg class="h-8 w-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8h16M4 12h16M4 16h16" />
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Mobile Menu Overlay -->
<div [class.hidden]="!isMenuOpen" class="mobile-menu-overlay animate-fadeIn">
    <button (click)="toggleMenu()" class="close-menu" aria-label="Close menu">
        <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>

    <div class="mobile-menu-content">
        <div class="mobile-logo">
            <img src="/home/lukenya_logo.svg" alt="Lukenya University" class="h-16 w-auto">
        </div>

        <nav class="mobile-nav">
            <a routerLink="/" (click)="isMenuOpen = false" routerLinkActive="active" [routerLinkActiveOptions]="{exact: true}">Home</a>
            <a routerLink="/about" (click)="isMenuOpen = false" routerLinkActive="active">About</a>

            <div class="mobile-nav-item">
                <button (click)="toggleSection('academics-module')" class="mobile-nav-link">
                    <span>Academics</span>
                    <span class="chevron-btn" [class.active]="expandedSection === 'academics-module'">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                        </svg>
                    </span>
                </button>
                <div [class.max-h-0]="expandedSection !== 'academics-module'" class="mobile-subnav overflow-hidden transition-all duration-300">
                    <a routerLink="/academics/schools/agriculture-natural-sciences" (click)="isMenuOpen = false" routerLinkActive="active">School of Agriculture, Technical Studies and Natural Sciences</a>
                    <a routerLink="/academics/schools/health-sciences" (click)="isMenuOpen = false" routerLinkActive="active">School of Health Sciences</a>
                    <a routerLink="/academics/schools/business-economics" (click)="isMenuOpen = false" routerLinkActive="active">School of Business and Economics</a>
                    <a routerLink="/academics/schools/education-social-sciences" (click)="isMenuOpen = false" routerLinkActive="active">School of Education &amp; Social Sciences</a>
                    <a routerLink="/academics/short-courses" (click)="isMenuOpen = false">Short Courses</a>
                    <a href="https://portal.hef.co.ke/auth/signin" target="_blank" rel="noopener noreferrer" (click)="isMenuOpen = false">HELB Loan Applications</a>
                </div>
            </div>

            <div class="mobile-nav-item">
                <button (click)="toggleSection('student')" class="mobile-nav-link">
                    <span>Student Life</span>
                    <span class="chevron-btn" [class.active]="expandedSection === 'student'">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                        </svg>
                    </span>
                </button>
                <div [class.max-h-0]="expandedSection !== 'student'" class="mobile-subnav overflow-hidden transition-all duration-300">
                    <a routerLink="/campus-life-overview" (click)="isMenuOpen = false" routerLinkActive="active">Students Overview</a>
                    <a routerLink="/campus-life-main" (click)="isMenuOpen = false" routerLinkActive="active">Campus Life</a>
                    <a routerLink="/virtual-tour" (click)="isMenuOpen = false">Virtual campus</a>
                    <a routerLink="/campus-culture-week" (click)="isMenuOpen = false" routerLinkActive="active">Lukenya Cultural Week Festival</a>
                    <a href="#" (click)="isMenuOpen = false">Student Portal</a>
                    <a href="#" (click)="isMenuOpen = false">Download Student Handbook</a>
                    <a href="https://students.kuccps.net/login/" target="_blank" rel="noopener noreferrer" (click)="isMenuOpen = false">KUCCPS</a>
                </div>
            </div>

            <a routerLink="/graduation" (click)="isMenuOpen = false" routerLinkActive="active">Graduations</a>
            <a routerLink="/contact" (click)="isMenuOpen = false" routerLinkActive="active">Contact</a>
        </nav>

        <a routerLink="/application-overview" class="mobile-cta" (click)="isMenuOpen = false">Apply Now</a>
    </div>
</div>
`, styles: ['/* src/app/shared/header/header.css */\n:host {\n  display: block;\n  position: relative;\n  z-index: 50;\n}\n.topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  background: #01884E;\n  color: #ffffff;\n  padding: 0 clamp(16px, 2vw, 32px);\n  min-height: 32px;\n  font-size: clamp(13px, 2vw, 16px);\n  flex-wrap: wrap;\n}\n.contact-line,\n.utility-nav,\n.primary-nav {\n  display: flex;\n  align-items: center;\n}\n.contact-line {\n  gap: clamp(8px, 1.5vw, 16px);\n  flex-wrap: wrap;\n}\n.contact-line > span {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n.utility-nav {\n  gap: clamp(12px, 2vw, 22px);\n  flex-wrap: wrap;\n}\n.utility-nav a {\n  color: inherit;\n  text-decoration: none;\n  white-space: nowrap;\n}\n.main-nav {\n  background: #ffffff;\n  padding: 0 clamp(16px, 2vw, 32px);\n  height: 76px;\n  position: relative;\n  z-index: 60;\n}\n.nav-container {\n  max-width: 1400px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n  height: 100%;\n}\n.brand {\n  display: inline-flex;\n  align-items: center;\n  gap: clamp(4px, 1.5vw, 8px);\n  color: #01884E;\n  font-weight: 800;\n  font-size: clamp(12px, 2.5vw, 16px);\n  min-width: 0;\n  flex-wrap: wrap;\n}\n.brand img {\n  height: clamp(26px, 4vw, 134px);\n  width: auto;\n  object-fit: contain;\n}\n.brand span {\n  white-space: nowrap;\n}\n.primary-nav {\n  display: flex;\n  gap: clamp(12px, 2vw, 28px);\n  justify-content: center;\n  align-items: center;\n  color: #444;\n  font-size: clamp(14px, 1.45vw, 20px);\n  font-weight: 400;\n}\n.nav-link {\n  display: inline-flex;\n  align-items: center;\n  gap: clamp(6px, 1vw, 12px);\n  color: inherit;\n  text-decoration: none;\n  padding: 6px 4px;\n  white-space: nowrap;\n}\n.nav-link:hover,\n.nav-link.active,\n.nav-item:focus-within > .nav-link,\n.nav-item:hover > .nav-link {\n  color: #01884e;\n}\n.nav-item {\n  position: relative;\n}\n.chevron {\n  width: 10px;\n  height: 10px;\n  display: inline-block;\n  transform: rotate(45deg);\n  border-right: 2px solid currentColor;\n  border-bottom: 2px solid currentColor;\n  margin-left: 6px;\n  flex-shrink: 0;\n  transition: transform 0.2s ease;\n}\n.nav-item:focus-within .chevron,\n.nav-item:hover .chevron {\n  transform: rotate(225deg);\n  margin-top: -2px;\n}\n.dropdown-menu {\n  position: absolute;\n  top: calc(100% + 10px);\n  left: 50%;\n  transform: translateX(-50%) translateY(-4px);\n  min-width: 320px;\n  max-width: min(90vw, 700px);\n  background: #fff;\n  border-radius: 18px;\n  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.12);\n  padding: 28px 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 18px;\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  transition:\n    opacity .2s ease,\n    visibility .2s ease,\n    transform .2s ease;\n  z-index: 100;\n}\n.nav-item:focus-within > .dropdown-menu,\n.nav-item:hover > .dropdown-menu {\n  opacity: 1;\n  visibility: visible;\n  pointer-events: auto;\n  transform: translateX(-50%) translateY(0);\n}\n.academics-dropdown > .dropdown-menu {\n  left: 50%;\n  transform: translateX(-50%) translateY(-4px);\n}\n.academics-dropdown:focus-within > .dropdown-menu,\n.academics-dropdown:hover > .dropdown-menu {\n  transform: translateX(-50%) translateY(0);\n}\n.dropdown-link {\n  display: block;\n  color: #2c2c2c;\n  font-size: clamp(14px, 2vw, 18px);\n  padding: 8px 14px 18px;\n  text-decoration: none;\n  position: relative;\n  border-radius: 6px;\n  transition:\n    background 0.2s ease,\n    color 0.2s ease,\n    padding-left 0.2s ease;\n}\n.dropdown-link::after {\n  content: "";\n  position: absolute;\n  left: 14px;\n  bottom: 8px;\n  width: 0;\n  height: 3px;\n  background: #f9ce31;\n  transition: width 0.25s ease;\n}\n.dropdown-link:hover {\n  background: #fffaf0;\n  padding-left: 20px;\n}\n.dropdown-link:hover::after {\n  width: 46px;\n}\n.dropdown-link.active {\n  color: #01884e;\n  font-weight: 600;\n}\n.dropdown-link.active::after {\n  width: 46px;\n  background: #01884e;\n}\n.dropdown-link.highlighted {\n  background: #fffaf0;\n  border-radius: 8px;\n  padding-top: 14px;\n  padding-bottom: 26px;\n}\n.dropdown-link.highlighted:hover {\n  background: #fff3d6;\n}\n.nav-cta {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  background: #f9ce32;\n  color: #141414;\n  border-radius: 999px;\n  height: 38px;\n  min-width: 100px;\n  padding: 0 clamp(12px, 2vw, 20px);\n  font-weight: 600;\n  text-decoration: none;\n  white-space: nowrap;\n  font-size: clamp(13px, 1.5vw, 16px);\n}\n.nav-actions {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n}\n.mobile-toggle {\n  display: none;\n  background: none;\n  border: none;\n  color: #01884E;\n  cursor: pointer;\n  padding: 4px;\n}\n.mobile-toggle:focus {\n  outline: none;\n}\n.mobile-menu-overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  background-color: #018f4d;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  color: white;\n}\n.mobile-menu-overlay.hidden {\n  display: none;\n}\n.close-menu {\n  position: absolute;\n  top: 32px;\n  right: 32px;\n  background: none;\n  border: none;\n  color: white;\n  cursor: pointer;\n}\n.mobile-menu-content {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 32px;\n  width: 100%;\n}\n.mobile-logo {\n  margin-bottom: 16px;\n}\n.mobile-nav {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 24px;\n}\n.mobile-nav a {\n  color: white;\n  text-decoration: none;\n  font-size: 24px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  transition: color 0.3s;\n}\n.mobile-nav a:hover,\n.mobile-nav a.active {\n  color: #f9ce32;\n}\n.mobile-nav-item {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  width: 100%;\n}\n.mobile-nav-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: none;\n  border: none;\n  color: white;\n  font-size: 24px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  cursor: pointer;\n  transition: color 0.3s;\n}\n.mobile-nav-link:hover {\n  color: #f9ce32;\n}\n.chevron-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.1);\n  transition: background 0.3s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.chevron-btn svg {\n  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.chevron-btn.active {\n  background: rgba(255, 255, 255, 0.2);\n}\n.chevron-btn.active svg {\n  transform: rotate(180deg);\n}\n.mobile-subnav {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 12px;\n  margin-top: 16px;\n}\n.mobile-subnav a {\n  font-size: 15px;\n  font-weight: 500;\n  text-transform: none;\n  letter-spacing: 0;\n  color: rgba(255, 255, 255, 0.85);\n  transition: color 0.2s;\n  max-width: 320px;\n  text-align: center;\n  line-height: 1.4;\n  padding: 0 16px;\n}\n.mobile-subnav a:hover,\n.mobile-subnav a.active {\n  color: #f9ce32;\n}\n.mobile-cta {\n  background: #f9ce32;\n  color: #141414;\n  padding: 16px 40px;\n  border-radius: 999px;\n  font-weight: 700;\n  text-decoration: none;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  margin-top: 16px;\n}\n@media (max-width: 1024px) {\n  .desktop-only {\n    display: none !important;\n  }\n  .mobile-toggle {\n    display: block;\n  }\n}\n@media (max-width: 1180px) {\n  .brand {\n    justify-self: start;\n  }\n  .dropdown-menu {\n    min-width: min(84vw, 700px);\n  }\n}\n@media (max-width: 820px) {\n  .brand img {\n    height: clamp(24px, 3.5vw, 30px);\n  }\n  .nav-link {\n    padding: 8px 6px;\n  }\n  .topbar {\n    min-height: auto;\n    padding: 10px clamp(12px, 2vw, 16px);\n    justify-content: center;\n    text-align: center;\n    gap: 8px;\n  }\n  .contact-line {\n    justify-content: center;\n  }\n  .utility-nav {\n    justify-content: center;\n  }\n  .contact-line span {\n    font-size: clamp(11px, 1.8vw, 13px);\n  }\n}\n@media (max-width: 620px) {\n  .topbar {\n    flex-direction: column;\n    align-items: center;\n    gap: 8px;\n    min-height: auto;\n    padding: 10px 12px;\n  }\n  .contact-line {\n    justify-content: center;\n    gap: 8px;\n  }\n  .utility-nav {\n    flex-direction: row;\n    flex-wrap: wrap;\n    gap: 12px;\n    justify-content: center;\n    font-size: 12px;\n  }\n  .utility-nav a {\n    padding: 2px 0;\n  }\n  .brand {\n    justify-self: auto;\n    font-size: 11px;\n    gap: 4px;\n  }\n  .brand img {\n    height: 22px;\n  }\n  .brand span {\n    font-size: 10px;\n  }\n}\n@media (max-width: 480px) {\n  .topbar {\n    padding: 8px 10px;\n  }\n  .contact-line {\n    font-size: 11px;\n    gap: 4px;\n    flex-direction: column;\n    align-items: center;\n  }\n  .utility-nav {\n    font-size: 11px;\n    gap: 8px;\n  }\n  .brand {\n    font-size: 9px;\n    gap: 3px;\n  }\n  .brand img {\n    height: 20px;\n  }\n}\n.animate-fadeIn {\n  animation: fadeIn 0.4s ease-out;\n}\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n    transform: scale(0.95);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n/*# sourceMappingURL=header.css.map */\n'] }]
