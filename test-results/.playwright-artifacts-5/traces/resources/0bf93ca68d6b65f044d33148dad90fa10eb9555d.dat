er {\n  color: #f9ce32;\n}\n.chevron-btn[_ngcontent-%COMP%] {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.1);\n  transition: background 0.3s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.chevron-btn[_ngcontent-%COMP%]   svg[_ngcontent-%COMP%] {\n  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.chevron-btn.active[_ngcontent-%COMP%] {\n  background: rgba(255, 255, 255, 0.2);\n}\n.chevron-btn.active[_ngcontent-%COMP%]   svg[_ngcontent-%COMP%] {\n  transform: rotate(180deg);\n}\n.mobile-subnav[_ngcontent-%COMP%] {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 12px;\n  margin-top: 16px;\n}\n.mobile-subnav[_ngcontent-%COMP%]   a[_ngcontent-%COMP%] {\n  font-size: 15px;\n  font-weight: 500;\n  text-transform: none;\n  letter-spacing: 0;\n  color: rgba(255, 255, 255, 0.85);\n  transition: color 0.2s;\n  max-width: 320px;\n  text-align: center;\n  line-height: 1.4;\n  padding: 0 16px;\n}\n.mobile-subnav[_ngcontent-%COMP%]   a[_ngcontent-%COMP%]:hover, \n.mobile-subnav[_ngcontent-%COMP%]   a.active[_ngcontent-%COMP%] {\n  color: #f9ce32;\n}\n.mobile-cta[_ngcontent-%COMP%] {\n  background: #f9ce32;\n  color: #141414;\n  padding: 16px 40px;\n  border-radius: 999px;\n  font-weight: 700;\n  text-decoration: none;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  margin-top: 16px;\n}\n@media (max-width: 1024px) {\n  .desktop-only[_ngcontent-%COMP%] {\n    display: none !important;\n  }\n  .mobile-toggle[_ngcontent-%COMP%] {\n    display: block;\n  }\n}\n@media (max-width: 1180px) {\n  .brand[_ngcontent-%COMP%] {\n    justify-self: start;\n  }\n  .dropdown-menu[_ngcontent-%COMP%] {\n    min-width: min(84vw, 700px);\n  }\n}\n@media (max-width: 820px) {\n  .brand[_ngcontent-%COMP%]   img[_ngcontent-%COMP%] {\n    height: clamp(24px, 3.5vw, 30px);\n  }\n  .nav-link[_ngcontent-%COMP%] {\n    padd